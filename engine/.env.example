# ============================================================
#  engine/.env.example — copy to engine/.env and fill in.
#  Never commit the real .env.
# ============================================================

# ── OpenAI ──────────────────────────────────────────────────
# Required. The agent will refuse to start without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Database ────────────────────────────────────────────────
# The scraper's ingestion database. We READ `announcements` from it and own
# the `filing_analyses` / `stock_alerts` tables inside it.
#
# Running against the docker-compose stack in D:\prathmesh\shares from your
# host: the db service publishes 5432 on host port 5433 (DB_PORT_EXTERNAL).
# Running as a service INSIDE that compose file: use DB_HOST=db, DB_PORT=5432.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=nse_ingestion
DB_USER=postgres
DB_PASSWORD=

# ── Where the scraper's PDFs live ───────────────────────────
# `announcements.local_path` is stored RELATIVE (storage/pdf/FOO.pdf), so this
# is the directory it is relative TO.
#   - on the host, pointed at the shares checkout:  D:\prathmesh\shares
#   - inside docker-compose with shared_storage mounted at /app/storage: /app
SCRAPER_BASE_PATH=D:\prathmesh\shares

# Optional last-resort lookup by basename, for when the scraper and this
# service disagree about their base directory.
PDF_STORAGE_PATH=

# ============================================================
#  THE FORMULA — every threshold and weight is tunable here.
#  Defaults match the spec: 25% profit, 50% revenue, orders in crore.
# ============================================================

# Rule 1 — profit (PAT) growth, year-over-year
PROFIT_GROWTH_MIN_PCT=25
PROFIT_WEIGHT=35
# Growth at which this rule earns its full weight
PROFIT_GROWTH_FULL_PCT=100

# Rule 2 — revenue growth, year-over-year
REVENUE_GROWTH_MIN_PCT=50
REVENUE_WEIGHT=35
REVENUE_GROWTH_FULL_PCT=200

# Rule 3 — order wins, in Rs crore
ORDER_MIN_CR=1
ORDER_WEIGHT=30
ORDER_FULL_CR=1000

# Share of a rule's weight banked just for clearing its threshold; the rest is
# earned by the size of the beat. 0.7 = "clearing the bar is most of the story".
BASE_CREDIT=0.7

# A filing becomes an alert at or above this score. 20 is below the smallest
# possible single-rule contribution (30 x 0.7 = 21), so any one rule firing is
# enough to surface the stock.
ALERT_MIN_SCORE=20

# Conviction bands for the dashboard badges
BAND_STRONG=70
BAND_MODERATE=45

# ── Worker ──────────────────────────────────────────────────
POLL_INTERVAL_SEC=60
BATCH_SIZE=25
WORKER_THREADS=4
MAX_ANALYSIS_RETRIES=3
# How far back to look. Keep this small on first run or the agent will try to
# analyse the entire back-catalogue at once.
BACKFILL_DAYS=7
# Cheap keyword gate before the model call. Turning it off sends EVERY filing
# to OpenAI — more thorough, roughly 10x the cost.
PREFILTER_ENABLED=true
# Default dashboard window
ALERT_TTL_DAYS=5

# ── Cross-exchange duplicate detection ──────────────────────
# NSE and BSE publish the SAME filing under different pdf_urls, so the scraper
# stores two `announcements` rows for one event. The agent identifies the
# document by hashing its text, so only the first copy is analysed.
#
# Minimum normalised characters needed to fingerprint a document. Below this it
# is not deduped (safer than merging two filings that only share boilerplate).
# The bot uses 400, but it has a subject-line fallback and we don't — and a
# typical one-page order-win letter flattens to ~360 characters.
FINGERPRINT_MIN_CHARS=200
# Two filings are only ever the same document if filed within this many hours.
# Cross-exchange copies arrive minutes apart; this bounds the damage from a
# hash collision so it can't suppress an unrelated alert weeks later.
DEDUP_WINDOW_HOURS=72

# ── PDF text extraction ─────────────────────────────────────
# OCR is only reached for scanned filings whose text layer is missing or
# mojibake. Needs the tesseract-ocr system package.
OCR_ENABLED=true
OCR_DPI=300
OCR_LANGS=eng
OCR_MAX_PAGES=10
OCR_TIME_BUDGET_SEC=45
# Cap on characters sent to the model, for predictable per-filing cost.
MAX_PDF_CHARS=60000
LLM_TIMEOUT_SEC=60
LLM_MAX_RETRIES=3

# ── API ─────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5174,http://localhost:5173
